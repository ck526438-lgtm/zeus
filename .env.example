# Copie ce fichier en .env ou définis ces variables dans Windows
ZEUS_MT5_LOGIN=12345678
ZEUS_MT5_PASSWORD=ton_mot_de_passe
ZEUS_MT5_SERVER=NomDuBroker-Demo
ZEUS_TG_TOKEN=
ZEUS_TG_CHAT=

# --- Zeus HFT (préfixe ZEUS_HFT_, voir zeus_hft/config/settings.py) ---
ZEUS_HFT_SYMBOL=XAUUSD
ZEUS_HFT_ORDER_QTY=0.01
ZEUS_HFT_MAX_NET_INVENTORY=0.05
ZEUS_HFT_MAX_DAILY_DRAWDOWN=300
ZEUS_HFT_MAX_ORDERS_PER_SECOND=8
ZEUS_HFT_MAX_LATENCY_MS=150
ZEUS_HFT_POLL_INTERVAL_MS=2
ZEUS_HFT_USE_MARKET_BOOK=true
# ZEUS_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Stratégies (v2.2) : auto | momentum | meanrev | obi
ZEUS_HFT_STRATEGY=auto
ZEUS_HFT_NEWS_TIMES_UTC=13:30
ZEUS_HFT_MAX_DAILY_LOSS_PCT=3
ZEUS_HFT_MOMENTUM_SESSIONS_UTC=07:00-11:00,13:30-17:00
ZEUS_HFT_MEANREV_SESSIONS_UTC=19:30-21:30,00:30-06:00
# v2.3 : gestion du capital, filtres
ZEUS_HFT_RISK_PER_TRADE_PCT=0.5
ZEUS_HFT_MAX_LOTS=1.0
ZEUS_HFT_BREAKEVEN_AT_R=1.0
ZEUS_HFT_PARTIAL_CLOSE_FRAC=0.5
ZEUS_HFT_TRAIL_ATR=1.0
ZEUS_HFT_MAX_CONSECUTIVE_LOSSES=4
ZEUS_HFT_TREND_FILTER=true
ZEUS_HFT_SPREAD_AVG_MULT=1.5
ZEUS_HFT_DEVIATION_POINTS=10
